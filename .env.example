PORT=8080
APP_ENV=development

# Database (empty = in-memory; set REQUIRE_POSTGRES=true in production)
DATABASE_URL=postgres://filament:filament@localhost:5432/filament?sslmode=disable
# REQUIRE_POSTGRES=true
# ALLOW_INMEMORY=1

REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0

PUBLIC_BASE_URL=http://localhost:8080
# CORS_ALLOWED_ORIGINS=http://localhost:8080

# Secrets (required in production; never use placeholders in prod)
BAMBU_SECRETS_KEY=local-dev-change-me-to-long-random
SESSION_SECRET=local-dev-session-secret-change-me

# Admin login (session cookie). In production use ADMIN_PASSWORD_HASH (bcrypt).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# ADMIN_PASSWORD_HASH=
# SESSION_TTL=24h
# COOKIE_SECURE=false

# Intervals
# BAMBU_MONITOR_INTERVAL=7s
# RUNTIME_SYNC_INTERVAL=2s
# CLOUD_SYNC_INTERVAL=2m
# SSE_HEARTBEAT=15s
# SCHEDULER_TICK=10s
# NOTIFICATION_TTL=24h

# HTTP
# HTTP_READ_HEADER_TIMEOUT=5s
# HTTP_IDLE_TIMEOUT=60s
# HTTP_WRITE_TIMEOUT=60s
# HTTP_SHUTDOWN_TIMEOUT=5s
# HTTP_MAX_BODY_BYTES=1048576

# Business knobs
SPOOL_LOW_WEIGHT_G=200
PRINTER_POWER_KW=0.35
LABOR_PER_HOUR=12
ELECTRICITY_RATE_PERSON=0.1176
ELECTRICITY_RATE_LEGAL=0.18381

# SQL migrations directory (used by cmd/migrate and docker compose migrate service)
MIGRATIONS_DIR=db/migrations

# SQL_DEBUG=false
