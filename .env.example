PORT=8080
DATABASE_URL=postgres://filament:filament@localhost:5432/filament?sslmode=disable
REDIS_ADDR=localhost:6379
PUBLIC_BASE_URL=http://localhost:8080
# On Railway: leave empty or set https://<service>.up.railway.app (RAILWAY_PUBLIC_DOMAIN is auto-used for QR).
# Encrypt Bambu password/token at rest (recommended). Falls back to APP_SECRET / DATABASE_URL.
BAMBU_SECRETS_KEY=change-me-to-a-long-random-string
# Bambu Cloud: sign in once in the UI; session persists until Logout.
# Bambu LAN: optional local MQTT; app must reach the printer on LAN (needs Tailscale/VPN from cloud).
SQL_DEBUG=1
# ALLOW_INMEMORY=1
